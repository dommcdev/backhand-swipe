{
  "name": "backhand-swipe-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "cd ../frontend && bun run build && cd ../backend && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "db:migrate": "bun scripts/db.ts migrate",
    "db:import": "bun scripts/db.ts import",
    "db:reset": "bun scripts/db.ts reset",
    "images": "bun scripts/images.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "csv-parse": "^7.0.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
