{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backhand-swipe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "backhandswipe.com",
      "custom_domain": true
    }
  ],
  "assets": {
    // The Vite plugin fills in the directory with the built app.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backhand-swipe"
      // database_id is added by `bunx wrangler d1 create backhand-swipe --binding DB --update-config`.
    }
  ],
  "triggers": {
    // Daily rating snapshot for the "This week" column. Times are UTC.
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
